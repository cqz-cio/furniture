# Copy to .env beside docker-compose.full.yml before local Compose startup.
MYSQL_ROOT_PASSWORD=replace-with-a-local-password

# Path to the separate cqz-cio/furniture-2b-web checkout's formal website.
# Typical sibling-repository layout:
# VANZ_WEB_CONTEXT=../furniture-2b-web/vanz-homepage-prototype
# Current combined local workspace layout:
VANZ_WEB_CONTEXT=../vanz-homepage-prototype

MYSQL_PORT=3306
REDIS_PORT=6379
ERP_BACKEND_PORT=48080
ERP_ADMIN_PORT=8080
VANZ_WEB_PORT=8081

ERP_PUBLIC_BASE_URL=http://localhost:48080
VANZ_PUBLIC_URL=http://localhost:8081
VANZ_APP_API_BASE=http://localhost:48080/app-api
