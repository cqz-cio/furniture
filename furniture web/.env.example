# Yudao app-api base URL used by storefront API modules.
VITE_YUDAO_APP_API_BASE=http://127.0.0.1:48080/app-api

# Yudao tenant header value.
VITE_YUDAO_APP_TENANT_ID=121

# Privacy-safe behavior analytics stays disabled until gateway/server release gates pass.
VITE_BEHAVIOR_TRACKING_ENABLED=false
VITE_ANALYTICS_CONSENT_REQUIRED=true
VITE_ANALYTICS_VISITOR_TTL_DAYS=180

# Fallback Yudao area id for US addresses saved into member address book.
# Replace this with the production US area-tree node when available.
VITE_YUDAO_US_DEFAULT_AREA_ID=1

# Yudao pay channel code configured in the Yudao admin payment settings.
# Example values depend on the enabled channel, such as alipay_pc or wx_pub.
VITE_YUDAO_PAY_CHANNEL_CODE=

# Storefront address verification proxy paths on the Yudao app-api base.
# Leave these defaults unless the backend deploys different routes.
VITE_ADDRESS_VERIFICATION_PATH=/member/address/verify
VITE_ADDRESS_VERIFICATION_STATUS_PATH=/member/address/verification-status
