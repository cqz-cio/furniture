# Copy this file to .env.launch-smoke for launch smoke checks.
# Do not commit real tokens, real user identifiers, or real order identifiers.

# Public Yudao app-api URL that the smoke runner can reach.
YUDAO_SMOKE_BASE_URL=https://api.oakved.example/app-api

# Yudao tenant header value for the storefront member/trade app-api.
YUDAO_SMOKE_TENANT_ID=121

# Real Yudao App user token for the smoke account.
YUDAO_SMOKE_TOKEN=<real-app-user-token>

# Live order settlement smoke data. These values must belong to the token owner.
YUDAO_ORDER_SMOKE_SKU_ID=<real-in-stock-sku-id>
YUDAO_ORDER_SMOKE_CART_ID=<real-cart-row-id-for-that-user>
YUDAO_ORDER_SMOKE_ADDRESS_ID=<real-saved-address-id-for-that-user>
YUDAO_ORDER_SMOKE_COUNT=1

# Must match the payment channel configured in Yudao admin.
YUDAO_ORDER_SMOKE_PAY_CHANNEL_CODE=alipay_pc

# Used only when --create-order is explicitly passed.
YUDAO_ORDER_SMOKE_RETURN_ORIGIN=https://shop.oakved.example

# Keep false unless the launch operator intentionally wants a real smoke order.
YUDAO_ORDER_SMOKE_CREATE_ORDER=false
