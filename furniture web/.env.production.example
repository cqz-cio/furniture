# Copy this file to .env.production for a launch build.
# Use the public app-api URL that the browser can reach.
VITE_YUDAO_APP_API_BASE=https://api.oakved.example/app-api

# Yudao tenant header value for the storefront member/trade app-api.
VITE_YUDAO_APP_TENANT_ID=121

# Enable only after the consent, gateway Host+Origin, HMAC and monitoring gates pass.
VITE_BEHAVIOR_TRACKING_ENABLED=false
VITE_ANALYTICS_CONSENT_REQUIRED=true
VITE_ANALYTICS_VISITOR_TTL_DAYS=180

# Production Yudao area id fallback for manually entered US addresses.
VITE_YUDAO_US_DEFAULT_AREA_ID=100200

# Yudao pay channel code configured in admin payment settings.
VITE_YUDAO_PAY_CHANNEL_CODE=alipay_pc

# Storefront address verification proxy paths on the Yudao app-api base.
VITE_ADDRESS_VERIFICATION_PATH=/member/address/verify
VITE_ADDRESS_VERIFICATION_STATUS_PATH=/member/address/verification-status

# Never expose the developer token panel in production.
VITE_SHOW_AUTH_TOKEN_PANEL=false
