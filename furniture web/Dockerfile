FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_YUDAO_APP_API_BASE
ARG VITE_YUDAO_APP_TENANT_ID
ARG VITE_YUDAO_US_DEFAULT_AREA_ID
ARG VITE_YUDAO_PAY_CHANNEL_CODE
ARG VITE_ADDRESS_VERIFICATION_PATH
ARG VITE_ADDRESS_VERIFICATION_STATUS_PATH

ENV VITE_YUDAO_APP_API_BASE=$VITE_YUDAO_APP_API_BASE
ENV VITE_YUDAO_APP_TENANT_ID=$VITE_YUDAO_APP_TENANT_ID
ENV VITE_YUDAO_US_DEFAULT_AREA_ID=$VITE_YUDAO_US_DEFAULT_AREA_ID
ENV VITE_YUDAO_PAY_CHANNEL_CODE=$VITE_YUDAO_PAY_CHANNEL_CODE
ENV VITE_ADDRESS_VERIFICATION_PATH=$VITE_ADDRESS_VERIFICATION_PATH
ENV VITE_ADDRESS_VERIFICATION_STATUS_PATH=$VITE_ADDRESS_VERIFICATION_STATUS_PATH

RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/ /usr/share/nginx/html/
EXPOSE 80
